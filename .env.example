# Required. Token of a Supervity user who can run the Digital FDE workflow (Bearer JWT).
SUPERVITY_TOKEN=
# Required. Id of the published Digital FDE workflow (open it in Supervity and copy it from the URL).
WORKFLOW_ID=

# Optional
SUPERVITY_BASE_URL=https://auto.supervity.ai
# hybrid (default): rules for simple chats, Supervity agent for large/unclear turns, attachments, manual.
# local: rules only (manual returns agent_required). agent: always call Supervity.
FDE_MODE=hybrid
# In hybrid mode, messages longer than this (or with a sample_file_url) go to the agent.
LARGE_MESSAGE_CHARS=400
CHAT_TIMEOUT_S=120
MANUAL_TIMEOUT_S=240
RATE_LIMIT=20
# development (default) or production. Production refuses to start without token/workflow and disables OpenAPI docs.
APP_ENV=development
# Comma-separated Host header values allowed when set (enables TrustedHost). Example: app.example.com,localhost
ALLOWED_HOSTS=
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated hosts the manual download link may point to. Empty allows any https host.
ALLOWED_FILE_HOSTS=
# Comma-separated hosts a sample_file_url may point to. Empty allows any public https host
# (IP addresses, localhost and .local/.internal names are always refused).
ALLOWED_SAMPLE_HOSTS=
# Your delivery history as JSON, so estimates stop using placeholder hours. See agent/rate_card.example.json
RATE_CARD_JSON=
# Save every raw agent stream to this folder (contains conversation text). Use for debugging only.
RECORD_STREAMS_DIR=
